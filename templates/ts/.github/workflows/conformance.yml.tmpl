name: BranchKit Conformance

on:
  push:
    tags:
      - 'v*'

jobs:
  conformance:
    # GitHub names a check run after its job, not its workflow, and
    # branchkit-cli finds the conformance result by this name: keep it.
    name: BranchKit Conformance
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Download branchkit-cli
        run: |
          CLI_VERSION="latest"
          ARCH=$(uname -m)
          if [ "$ARCH" = "x86_64" ]; then ARCH="amd64"; fi
          if [ "$ARCH" = "aarch64" ]; then ARCH="arm64"; fi
          OS=$(uname -s | tr '[:upper:]' '[:lower:]')

          # GitHub serves `latest` at releases/latest/download/ and a tag at
          # releases/download/<tag>/ — the two paths are not symmetric.
          case "$CLI_VERSION" in
            latest) REL="latest/download" ;;
            *) REL="download/${CLI_VERSION}" ;;
          esac
          DOWNLOAD_URL="https://github.com/branchkit/branchkit-cli/releases/${REL}/branchkit-cli-${OS}-${ARCH}.tar.gz"
          curl -fsSL "$DOWNLOAD_URL" -o /tmp/branchkit-cli.tar.gz
          tar -xzf /tmp/branchkit-cli.tar.gz -C /usr/local/bin/
          chmod +x /usr/local/bin/branchkit-cli

      - name: Set up Bun
        uses: oven-sh/setup-bun@v2

      - name: Install dependencies
        run: bun install

      - name: Run conformance checks
        run: branchkit-cli dev test . --static-only
