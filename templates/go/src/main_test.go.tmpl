package main

import (
	"testing"

	"github.com/branchkit/plugin-sdk-go/harness"
)

func TestGreetDefault(t *testing.T) {
	h := harness.Start(t, ".")
	result := h.MustSimulateCommand("hello branchkit")
	if result.ActionType() != "{{.ActionPrefix}}.greet" {
		t.Fatalf("expected action type %q, got %q", "{{.ActionPrefix}}.greet", result.ActionType())
	}
}

func TestGreetCapture(t *testing.T) {
	h := harness.Start(t, ".")
	result := h.MustSimulateCommand("hello world")
	var params struct {
		Name string `json:"name"`
	}
	if err := result.ActionParams(&params); err != nil {
		t.Fatalf("ActionParams: %v", err)
	}
	if params.Name != "world" {
		t.Fatalf("expected name %q, got %q", "world", params.Name)
	}
}
